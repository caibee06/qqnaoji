# mock 无需密钥；api 使用兼容 Chat Completions 的模型服务
AI_MODE=mock
AI_BASE_URL=https://your-provider.example/v1
AI_API_KEY=
AI_MODEL=your-model-name
SYSTEM_PROMPT=你是一个友善的QQ助手，用简洁中文回答，不编造事实。
QQ_APP_ID=
QQ_APP_SECRET=
QQ_SANDBOX=true
# SnowLuma HTTP API 的授权 Token
ONEBOT_API_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
# 与 HTTP 推送客户端的授权 Token 一致
ONEBOT_REPORT_TOKEN=
# 可选：仅推送端支持签名时填写；同时填写时两种校验都必须通过
ONEBOT_REPORT_SECRET=
# 开启后提供本地测试页面；公开部署前关闭
ENABLE_DEMO=true
DATABASE_PATH=data/chat.db
HISTORY_TURNS=10
RATE_LIMIT_SECONDS=3
MAX_INPUT_CHARS=2000
MAX_REPLY_CHARS=1500
